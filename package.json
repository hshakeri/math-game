{
  "name": "keybreakers",
  "version": "1.0.0",
  "private": true,
  "description": "Keybreakers: The Goblin’s Gate — a Socratic pixel RPG for home play",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": "^20.12.0 || >=22.0.0"
  },
  "scripts": {
    "start": "node --import ./server/load-env.js server/index.js",
    "dev": "node --import ./server/load-env.js --watch server/index.js",
    "test": "node --test",
    "validate": "node content/validate.js",
    "eval": "node eval/run.js",
    "eval:ci": "node eval/run.js --ci",
    "digest": "node server/telemetry/digest.js",
    "assets": "python3 tools/assets/generate.py"
  },
  "keywords": [
    "math",
    "education",
    "polya",
    "tutor",
    "vanilla-js"
  ],
  "author": "Heman Shakeri <hshakeri@users.noreply.github.com>",
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {}
}
