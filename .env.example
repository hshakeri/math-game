# Castle of Theorems v1 (Home Edition) — Environment Configuration
# Copy to .env; npm start and npm run dev load it automatically.
# Native dotenv loading requires Node 20.12+ on the 20.x LTS branch, or Node 22+.
# Exported shell variables take precedence. With no .env, scripted remains default.

# Tutor adapter: 'scripted' (offline authored probes, default) | 'agy' | 'gemini' | 'claude'
TUTOR_ADAPTER=scripted

# Authenticated Antigravity CLI tutor (run `agy` once to sign in, then select agy).
# The CLI gets an isolated temporary workspace and cannot use tools.
# No Gemini API key is required for this route. The offline tutor remains fallback.
# TUTOR_ADAPTER=agy
AGY_MODEL=gemini-3.8-flash-low
AGY_EFFORT=low
AGY_TIMEOUT_MS=30000
# AGY_BIN=agy

# HTTP server port (defaults to 3000 in code if unset; SPEC §1 uses 8080 for home LAN)
PORT=8080

# 4-digit child-proofing PIN for the Parent Dashboard at /parent (defaults to 1234 if unset)
PARENT_PIN=1234

# Google Gemini Direct REST API (used when TUTOR_ADAPTER=gemini)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude Direct REST API (used when TUTOR_ADAPTER=claude)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6-20260320)
# ANTHROPIC_MODEL=claude-sonnet-4-6-20260320

# Optional: set to 1 to enable Flesch-Kincaid reading-level warnings in `npm run validate`
# CHECK_FKGL=1
