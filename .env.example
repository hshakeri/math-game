# Castle of Theorems v1 (Home Edition) — Environment Configuration
# Copy to .env and pass `--env-file-if-exists=.env` to Node (Node 20.6+), e.g.:
#   node --env-file-if-exists=.env server/index.js

# Tutor adapter: 'scripted' (offline authored probes, default) | 'gemini' | 'claude'
TUTOR_ADAPTER=scripted

# HTTP server port (defaults to 3000 in code if unset; SPEC §1 uses 8080 for home LAN)
PORT=8080

# 4-digit child-proofing PIN for the Parent Dashboard at /parent (defaults to 1234 if unset)
PARENT_PIN=1234

# Google Gemini Direct REST API (used when TUTOR_ADAPTER=gemini)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude Direct REST API (used when TUTOR_ADAPTER=claude)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6-20260320)
# ANTHROPIC_MODEL=claude-sonnet-4-6-20260320

# Optional: set to 1 to enable Flesch-Kincaid reading-level warnings in `npm run validate`
# CHECK_FKGL=1
