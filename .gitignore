# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.local
.env.*.local
!.env.example

# Runtime telemetry & session data
data/sessions/*
!data/sessions/.gitkeep

# Evaluation runtime reports
eval/reports/*
!eval/reports/.gitkeep

# Teamwork and agent internal metadata
.agents/

# Python cache & tooling
__pycache__/
*.py[cod]
*$py.class
tools/assets/__pycache__/

# OS and Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.vscode/
.idea/

# Coverage and temporary artifacts
coverage/
*.tmp
*.temp

# Rebuildable art handoff archives and superseded local image drafts
docs/art/*.zip
docs/art/animation-pack/**/*-draft-*.png
